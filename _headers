# Response headers for every page on Cloudflare (Workers static assets read this
# file and do not serve it). The tools may only be framed by this site's own tab
# workspace (#24); a meta CSP cannot set frame-ancestors.
/*
  Content-Security-Policy: frame-ancestors 'self'
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
