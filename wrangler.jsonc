{
	// A static-assets-only Worker: no script, Cloudflare serves the repo's files as they are.
	// Forks: change account_id and the route to your own, or delete both and use workers.dev.
	"name": "tools",
	"account_id": "cbaf7c8b254ee4af435b9d6e32d2c6f1",
	"compatibility_date": "2026-10-05",
	"assets": {
		// The repo root is the site; .assetsignore keeps docs and config out of it.
		"directory": "."
	},
	"workers_dev": false,
	"preview_urls": false,
	"routes": [{ "pattern": "tools.whosane.dev", "custom_domain": true }]
}
